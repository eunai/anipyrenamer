# AniDB UDP API (copy to .env and fill in; do not commit .env)
# For global installs: put .env in %APPDATA%\anipyrenamer (Windows) or ~/.config/anipyrenamer (Unix).
# Loading: python-dotenv runs when the CLI starts (anipyrenamer.cli:main), not on import of the cli module (Security Plan 1 SEC-10).
# --debug: AniDB UDP debug output redacts pass= and s= (session); never commit real credentials.
# Security Plan 1: UDP receive buffer is 65535 bytes in code; no env var. AniDB responses are parsed defensively; cache migrations validate extra column names before ALTER TABLE (see plan).
# Permissions (Unix): recommended `chmod 600 .env` to limit access to your user only.
# Permissions (Windows): keep `.env` under your user profile or ensure NTFS ACLs restrict access.
ANIDB_USERNAME=
ANIDB_PASSWORD=

# Optional: only needed when UDP ENCRYPT is enabled (not for normal AUTH)
ANIDB_API_KEY=

ANIDB_UDP_CLIENT=anipyrenamer
ANIDB_UDP_CLIENTVER=1
ANIDB_LOCAL_PORT=0
